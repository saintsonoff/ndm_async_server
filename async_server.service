[Unit]
Description=NDM Async TCP/UDP Server
Documentation=https://github.com/saintsonoff/ndm_async_server
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/async_server
Environment="TCP_PORT=8080"
Environment="UDP_PORT=8040"

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log

# Resource limits
LimitNOFILE=65536
TasksMax=4096

# Restart policy
Restart=on-failure
RestartSec=5s
StartLimitInterval=60s
StartLimitBurst=3

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=async_server

[Install]
WantedBy=multi-user.target
